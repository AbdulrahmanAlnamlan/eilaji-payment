# Passcode for the merchant dashboard. Required in production; the demo falls
# back to "demo1234" only when NODE_ENV is not production.
MERCHANT_PASSCODE=change-me

# Optional. When both are set, links and payments persist in Upstash/Vercel KV
# instead of process memory (which resets between cold starts).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only needed by the legacy Tap-backed Eilaji subscription page (api/create-charge.js,
# api/verify-payment.js). Never commit a real key.
TAP_SECRET=
