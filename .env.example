# Copy to .env for local dev. NEVER commit the real values.
# Set these in Vercel: Project Settings -> Environment Variables.

# Tap secret key. sk_test_... for Preview/Development, sk_live_... for Production only.
TAP_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Public URL of this site, used to build the Tap redirect URL.
PUBLIC_BASE_URL=https://eilaji-payment.vercel.app

# Optional. Comma-separated origins allowed to call the API from a browser.
# Defaults to PUBLIC_BASE_URL.
ALLOWED_ORIGINS=https://eilaji-payment.vercel.app
