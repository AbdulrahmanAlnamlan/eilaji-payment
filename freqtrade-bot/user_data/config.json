{
    "$schema": "https://schema.freqtrade.io/schema.json",

    "//": "===================================================================",
    "//_1": " SAFETY: dry_run=true simulates trades (no orders sent).",
    "//_2": " Bybit demo_trading uses a REAL demo account on live markets.",
    "//_3": " Do NOT set dry_run=false until you have (a) funded a real",
    "//_4": " account, (b) validated in backtest + weeks of dry-run.",
    "//": "===================================================================",

    "dry_run": true,
    "dry_run_wallet": 1000,

    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "available_capital": 1000,
    "fiat_display_currency": "USD",
    "timeframe": "5m",
    "trading_mode": "spot",
    "margin_mode": "",

    "cancel_open_orders_on_exit": true,

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "bybit",
        "//": "demo_trading: true = Bybit demo account on live markets (safe).",
        "demo_trading": true,
        "//_key": "Credentials are injected from .env via environment variables.",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "SOL/USDT",
            "XRP/USDT",
            "BNB/USDT"
        ],
        "pair_blacklist": []
    },

    "pairlists": [
        { "method": "StaticPairList" }
    ],

    "protections": [
        { "method": "CooldownPeriod", "stop_duration_candles": 5 },
        {
            "method": "StoplossGuard",
            "lookback_period_candles": 24,
            "trade_limit": 4,
            "stop_duration_candles": 12,
            "only_per_pair": false
        },
        {
            "method": "MaxDrawdown",
            "lookback_period_candles": 48,
            "trade_limit": 20,
            "stop_duration_candles": 12,
            "max_allowed_drawdown": 0.2
        }
    ],

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "CHANGE_ME_run_the_openssl_command_in_the_README",
        "ws_token": "CHANGE_ME_TOO",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "CHANGE_ME_pick_a_strong_password"
    },

    "bot_name": "eilaji-bot",
    "initial_state": "running",
    "force_entry_enable": false,

    "internals": {
        "process_throttle_secs": 5
    }
}
