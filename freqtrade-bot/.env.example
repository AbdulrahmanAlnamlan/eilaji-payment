# ─── Bybit API credentials ───────────────────────────────────────────────
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#
# For DEMO trading (what this project is set up for by default):
#   1. Log in to Bybit → switch to "Demo Trading" (top-right account menu).
#   2. In the demo account, create an API key (API Management).
#   3. Permissions: enable "Trade" (spot). Do NOT enable withdrawals.
#   4. Paste the demo key/secret below.
#
# For LIVE trading (only after you've validated a strategy — see README):
#   Use a real (non-demo) API key, set demo_trading=false in config.json,
#   IP-whitelist the key, and keep withdrawals DISABLED.

FREQTRADE__EXCHANGE__KEY=your_bybit_api_key_here
FREQTRADE__EXCHANGE__SECRET=your_bybit_api_secret_here

# ─── Optional: Telegram control (recommended) ────────────────────────────
# Create a bot via @BotFather to get a token; get your chat id from @userinfobot.
# Then set telegram.enabled=true in config.json.
# FREQTRADE__TELEGRAM__TOKEN=your_telegram_bot_token
# FREQTRADE__TELEGRAM__CHAT_ID=your_telegram_chat_id
